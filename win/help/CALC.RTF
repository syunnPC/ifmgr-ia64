#{\footnote # calculating}${\footnote $ Calculating}K{\footnote K Calculating}+{\footnote + procedures:010}
\pard\sb120\sa120\li120{\b\fs28 Calculating}\par
\pard\li120\sa60\sb60{\b To work out a sum}\par
\pard\li360\fi-240\sa60 1.\tab Type the first number (or click its digits).\par
2.\tab Type an operator: + - * or /.\par
3.\tab Type the next number.\par
4.\tab Press = or ENTER for the result.\par
\pard\li120\sa120 C clears the calculation, CE the number being typed. Percent (%) works out a percentage of the first number. Sqrt takes the square root of the number shown and 1/x its reciprocal.\par
\page
#{\footnote # memory}${\footnote $ Using the Memory}K{\footnote K Using the Memory}+{\footnote + procedures:020}
\pard\sb120\sa120\li120{\b\fs28 Using the Memory}\par
\pard\li120\sa120 MS stores the number shown in the memory, M+ adds it to the memory, MR shows the memory, and MC clears it. An M in the box beside the display shows that the memory holds a number.\par
\page
#{\footnote # keyboard}${\footnote $ Calculator Keys}K{\footnote K keyboard;keys}
\pard\sb120\sa120\li120{\b\fs28 Calculator Keys}\par
\pard\li120\tx2520\sa60 0-9\tab The digits\par
+ - * /\tab Add, subtract, multiply, divide\par
= or ENTER\tab Equals\par
ESC\tab C: clear\par
F9\tab +/-: change the sign\par
DEL\tab CE: clear the entry\par
BACKSPACE\tab Back: the last digit\par
%\tab Percent\par
@\tab Sqrt\par
R\tab 1/x\par
CTRL+L\tab MC\par
CTRL+R\tab MR\par
CTRL+M\tab MS\par
CTRL+P\tab M+\par
CTRL+C\tab Copy\par
CTRL+V\tab Paste\par
F1\tab Help Index\par
\page
