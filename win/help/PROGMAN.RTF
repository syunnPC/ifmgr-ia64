#{\footnote # starting_programs}${\footnote $ Starting Programs}K{\footnote K Starting Programs}+{\footnote + procedures:010}
\pard\sb120\sa120\li120{\b\fs28 Starting Programs}\par
\pard\li120\sa120 Double-click a program item, or select it and press ENTER. Run on the File menu starts any program by its command line.\par
\page
#{\footnote # groups}${\footnote $ Working with Groups}K{\footnote K Working with Groups}+{\footnote + procedures:020}
\pard\sb120\sa120\li120{\b\fs28 Working with Groups}\par
\pard\li120\sa60\sb60{\b To make a group}\par
\pard\li360\fi-240\sa60 1.\tab From the File menu, choose New.\par
2.\tab Choose Program Group and OK.\par
3.\tab Type the group's description and choose OK.\par
\pard\li120\sa120 To add a program, choose New and Program Item, then type its description and command line. Move and Copy on the File menu put the selected item in another group.\par
\page
#{\footnote # keyboard}${\footnote $ Program Manager Keys}K{\footnote K keyboard;keys}
\pard\sb120\sa120\li120{\b\fs28 Program Manager Keys}\par
\pard\li120\tx2520\sa60 ENTER\tab Start the selected program\par
F7\tab Move\par
F8\tab Copy\par
DEL\tab Delete\par
ALT+ENTER\tab Properties\par
SHIFT+F5\tab Cascade\par
SHIFT+F4\tab Tile\par
CTRL+F6\tab The next group\par
CTRL+ESC\tab Task List\par
F1\tab Help Index\par
\page
