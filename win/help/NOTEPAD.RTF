#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;New;Open;Save;Save As;Print;Page Setup;Print Setup;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\fi-0\tx1800\sa60{\b New}\tab Starts a new, untitled file.\par
{\b Open}\tab Opens a text file.\par
{\b Save}\tab Saves the file under its name.\par
{\b Save As}\tab Saves the file under a new name.\par
{\b Print}\tab Prints the file on the printer chosen with Print Setup.\par
{\b Page Setup}\tab Sets the {\ul header and footer}{\v header_codes} and the margins of printed pages.\par
{\b Print Setup}\tab Chooses the printer and its settings.\par
{\b Exit}\tab Ends Notepad, asking first whether to save changes.\par
\page
#{\footnote # edit_menu}${\footnote $ Edit Menu Commands}K{\footnote K Edit menu;Undo;Cut;Copy;Paste;Delete;Select All;Time/Date;Word Wrap}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Edit Menu Commands}\par
\pard\li120\tx1800\sa60{\b Undo}\tab Undoes the last change.\par
{\b Cut}\tab Moves the selected text to the Clipboard.\par
{\b Copy}\tab Copies the selected text to the Clipboard.\par
{\b Paste}\tab Puts the Clipboard's text where the insertion point is.\par
{\b Delete}\tab Deletes the selected text.\par
{\b Select All}\tab Selects all of the file's text.\par
{\b Time/Date}\tab Puts the current time and date at the insertion point.\par
{\b Word Wrap}\tab Breaks long lines at the window's edge, or not.\par
\page
#{\footnote # search_menu}${\footnote $ Search Menu Commands}K{\footnote K Search menu;Find;Find Next}+{\footnote + commands:030}
\pard\sb120\sa120\li120{\b\fs28 Search Menu Commands}\par
\pard\li120\tx1800\sa60{\b Find}\tab Finds the text you type, up or down from the insertion point, with or without matching letter case.\par
{\b Find Next}\tab Finds the same text again.\par
\page
