#{\footnote # open_save}${\footnote $ Opening and Saving Files}K{\footnote K opening files;saving files;files}+{\footnote + procedures:010}
\pard\sb120\sa120\li120{\b\fs28 Opening and Saving Files}\par
\pard\li120\sa120{\b To open a file}\par
\pard\li360\fi-240\sa60 1.\tab From the File menu, choose Open.\par
2.\tab Type the file's name, or choose it from the list (choose a directory to see its files).\par
3.\tab Choose OK.\par
\pard\li120\sa120\sb120{\b To save a file}\par
\pard\li360\fi-240\sa60 1.\tab From the File menu, choose Save. Enter a name for a new file.\par
2.\tab To keep the file under another name, choose Save As and type the name.\par
\pard\li120\sb120 You can also start Notepad with a file: run NOTEPAD followed by the file's name.\par
\page
#{\footnote # editing}${\footnote $ Editing Text}K{\footnote K editing;selecting text;Clipboard}+{\footnote + procedures:020}
\pard\sb120\sa120\li120{\b\fs28 Editing Text}\par
\pard\li120\sa120 Type where the insertion point is. To select text, drag the mouse across it, or hold down SHIFT and move with the direction keys.\par
\pard\li120\sa120 Cut or copy selected text to the {\ul Clipboard}{\v clipboard_term}, then paste it in Notepad or another program. Undo reverses the last change.\par
\page
#{\footnote # find_text}${\footnote $ Finding Text}K{\footnote K finding text;searching}+{\footnote + procedures:030}
\pard\sb120\sa120\li120{\b\fs28 Finding Text}\par
\pard\li360\fi-240\sa60 1.\tab From the Search menu, choose Find.\par
2.\tab In the Find What box, type the text to find.\par
3.\tab To find only text in the same letter case, check Match Case.\par
4.\tab Choose Up or Down for the direction, then Find Next.\par
\pard\li120\sb120 To find the text again, choose Find Next from the Search menu, or press F3.\par
\page
#{\footnote # word_wrap}${\footnote $ Wrapping Lines}K{\footnote K word wrap;long lines}+{\footnote + procedures:040}
\pard\sb120\sa120\li120{\b\fs28 Wrapping Lines}\par
\pard\li120\sa120 Word Wrap on the Edit menu wraps long lines to fit the window without changing the file.\par
\page
#{\footnote # printing}${\footnote $ Printing a File}K{\footnote K printing;header;footer;margins}+{\footnote + procedures:050}
\pard\sb120\sa120\li120{\b\fs28 Printing a File}\par
\pard\li360\fi-240\sa60 1.\tab To choose the printer, choose Print Setup from the File menu.\par
2.\tab To change the header, footer or margins, choose Page Setup.\par
3.\tab From the File menu, choose Print.\par
\pard\li120\sb120 The text is printed in Courier at 10 points. See {\uldb Header and Footer Codes}{\v header_codes}.\par
\page
#{\footnote # header_codes}${\footnote $ Header and Footer Codes}K{\footnote K header codes;footer codes}
\pard\sb120\sa120\li120{\b\fs28 Header and Footer Codes}\par
\pard\li120\tx1080\sa60 &f\tab the file's name\par
&p\tab the page number\par
&d\tab the date\par
&t\tab the time\par
&l\tab what follows at the left\par
&c\tab what follows in the centre\par
&r\tab what follows at the right\par
&&\tab an ampersand\par
\pard\li120\sb120 Margins are in hundredths of an inch.\par
\page
#{\footnote # time_log}${\footnote $ Keeping a Log}K{\footnote K log;time;date}+{\footnote + procedures:060}
\pard\sb120\sa120\li120{\b\fs28 Keeping a Log}\par
\pard\li120\sa120 Choose Time/Date from the Edit menu (or press F5) to insert a timestamp for a log entry.\par
\page
#{\footnote # keyboard}${\footnote $ Notepad Keys}K{\footnote K keyboard;keys;shortcut keys}
\pard\sb120\sa120\li120{\b\fs28 Notepad Keys}\par
\pard\li120\tx2160\sa60 CTRL+Z\tab Undo\par
CTRL+X\tab Cut\par
CTRL+C\tab Copy\par
CTRL+V\tab Paste\par
DEL\tab Delete the selection, or the character after the insertion point\par
F3\tab Find Next\par
F5\tab Time/Date\par
F1\tab Help Index\par
Direction keys\tab Move the insertion point (with SHIFT, select)\par
HOME, END\tab The start or end of the line\par
CTRL+HOME, CTRL+END\tab The start or end of the file\par
\page
#{\footnote # clipboard_term}
\pard\li120\sa60{\b Clipboard}\par
\pard\li120 Stores cut or copied text and pictures for pasting in any program. Use the Clipboard viewer to see its contents.\par
}
