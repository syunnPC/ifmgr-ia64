#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;New;Open;Save;Save As;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\tx2160\sa60 {\b New}\tab Starts a new, untitled card file.\par
{\b Open}\tab Opens a card file saved earlier.\par
{\b Save}\tab Saves the card file under its name.\par
{\b Save As}\tab Saves the card file under a new name.\par
{\b Exit}\tab Ends the program, asking first whether to save changes.\par
\page
#{\footnote # edit_menu}${\footnote $ Edit Menu Commands}K{\footnote K Edit menu;Undo;Cut;Copy;Paste;Index}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Edit Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Undo}\tab Undoes the last change to the card.\par
{\b Cut}\tab Moves the selected text to the Clipboard.\par
{\b Copy}\tab Copies the selected text to the Clipboard.\par
{\b Paste}\tab Puts the Clipboard's text on the card.\par
{\b Index}\tab Changes the card's index line.\par
\page
#{\footnote # view_menu}${\footnote $ View Menu Commands}K{\footnote K View menu;Cards;List}+{\footnote + commands:030}
\pard\sb120\sa120\li120{\b\fs28 View Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Cards}\tab Shows overlapping cards; edit the front card.\par
{\b List}\tab Shows only the index lines, one per line.\par
\page
#{\footnote # card_menu}${\footnote $ Card Menu Commands}K{\footnote K Card menu;Add;Delete;Duplicate}+{\footnote + commands:040}
\pard\sb120\sa120\li120{\b\fs28 Card Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Add}\tab Adds a card with the index line you type.\par
{\b Delete}\tab Deletes the front card.\par
{\b Duplicate}\tab Adds a copy of the front card.\par
\page
#{\footnote # search_menu}${\footnote $ Search Menu Commands}K{\footnote K Search menu;Go To;Find;Find Next}+{\footnote + commands:050}
\pard\sb120\sa120\li120{\b\fs28 Search Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Go To}\tab Brings forward the card whose index line has the text you type.\par
{\b Find}\tab Searches card text.\par
{\b Find Next}\tab Finds the next match.\par
\page
