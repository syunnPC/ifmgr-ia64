#{\footnote # adding_cards}${\footnote $ Adding and Changing Cards}K{\footnote K Adding and Changing Cards}+{\footnote + procedures:010}
\pard\sb120\sa120\li120{\b\fs28 Adding and Changing Cards}\par
\pard\li120\sa60\sb60{\b To add a card}\par
\pard\li360\fi-240\sa60 1.\tab From the Card menu, choose Add (or press F7).\par
2.\tab Type the index line and choose OK.\par
3.\tab Type the card's text.\par
\pard\li120\sa120 To change a card's index line, choose Index from the Edit menu (or press F6), or double-click the index line.\par
\page
#{\footnote # finding_cards}${\footnote $ Finding Cards}K{\footnote K Finding Cards}+{\footnote + procedures:020}
\pard\sb120\sa120\li120{\b\fs28 Finding Cards}\par
\pard\li120\sa120 Click a card's index line to bring it forward, or use Go To (F4) with part of its index line. Find searches the cards' text; Find Next (F3) goes on. In the list view, PGUP and PGDN move a screenful.\par
\page
#{\footnote # keyboard}${\footnote $ Cardfile Keys}K{\footnote K keyboard;keys}
\pard\sb120\sa120\li120{\b\fs28 Cardfile Keys}\par
\pard\li120\tx2520\sa60 F6\tab Index\par
F7\tab Add a card\par
F4\tab Go To\par
F3\tab Find Next\par
CTRL+Z\tab Undo\par
CTRL+X\tab Cut\par
CTRL+C\tab Copy\par
CTRL+V\tab Paste\par
F1\tab Help Index\par
\page
