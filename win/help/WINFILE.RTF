#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;Open;Move;Copy;Delete;Rename;Create Directory;Run;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Open}\tab Opens the selected directory or starts the selected program.\par
{\b Move}\tab Moves the selected file.\par
{\b Copy}\tab Copies the selected file.\par
{\b Delete}\tab Deletes the selected file or directory.\par
{\b Rename}\tab Renames the selected file or directory.\par
{\b Create Directory}\tab Makes a new directory.\par
{\b Run}\tab Runs a program by its command line.\par
{\b Exit}\tab Ends File Manager.\par
\page
#{\footnote # disk_menu}${\footnote $ Disk Menu Commands}K{\footnote K Disk menu;Select Drive}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Disk Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Select Drive}\tab Shows another drive.\par
\page
#{\footnote # view_menu}${\footnote $ View Menu Commands}K{\footnote K View menu;Name;File Details}+{\footnote + commands:030}
\pard\sb120\sa120\li120{\b\fs28 View Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Name}\tab Shows only the names.\par
{\b File Details}\tab Shows each file's size, date, time and attributes.\par
\page
#{\footnote # window_menu}${\footnote $ Window Menu Commands}K{\footnote K Window menu;New Window;Cascade;Tile;Arrange Icons;Refresh}+{\footnote + commands:040}
\pard\sb120\sa120\li120{\b\fs28 Window Menu Commands}\par
\pard\li120\tx2160\sa60 {\b New Window}\tab Opens another directory window.\par
{\b Cascade}\tab Overlaps the windows.\par
{\b Tile}\tab Places the windows side by side.\par
{\b Arrange Icons}\tab Lines up the window icons.\par
{\b Refresh}\tab Reads the directory again.\par
\page
