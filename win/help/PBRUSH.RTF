#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;New;Open;Save;Save As;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\tx2160\sa60 {\b New}\tab Starts a new, untitled picture.\par
{\b Open}\tab Opens a picture saved earlier.\par
{\b Save}\tab Saves the picture under its name.\par
{\b Save As}\tab Saves the picture under a new name.\par
{\b Exit}\tab Ends the program, asking first whether to save changes.\par
\page
#{\footnote # edit_menu}${\footnote $ Edit Menu Commands}K{\footnote K Edit menu;Undo;Clear}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Edit Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Undo}\tab Undoes the last drawing.\par
{\b Clear}\tab Clears the whole picture to the background colour.\par
\page
