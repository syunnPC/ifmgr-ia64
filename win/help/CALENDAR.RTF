#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;New;Open;Save;Save As;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\tx2160\sa60 {\b New}\tab Starts a new, untitled calendar file.\par
{\b Open}\tab Opens a calendar file saved earlier.\par
{\b Save}\tab Saves the calendar file under its name.\par
{\b Save As}\tab Saves the calendar file under a new name.\par
{\b Exit}\tab Ends the program, asking first whether to save changes.\par
\page
#{\footnote # edit_menu}${\footnote $ Edit Menu Commands}K{\footnote K Edit menu;Cut;Copy;Paste}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Edit Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Cut}\tab Moves the selected text to the Clipboard.\par
{\b Copy}\tab Copies the selected text to the Clipboard.\par
{\b Paste}\tab Puts the Clipboard's text at the insertion point.\par
\page
#{\footnote # view_menu}${\footnote $ View Menu Commands}K{\footnote K View menu;Day;Month}+{\footnote + commands:030}
\pard\sb120\sa120\li120{\b\fs28 View Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Day}\tab Shows one day's appointments.\par
{\b Month}\tab Shows the whole month.\par
\page
#{\footnote # show_menu}${\footnote $ Show Menu Commands}K{\footnote K Show menu;Today;Previous;Next;Date}+{\footnote + commands:040}
\pard\sb120\sa120\li120{\b\fs28 Show Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Today}\tab Shows today.\par
{\b Previous}\tab Shows the day or month before.\par
{\b Next}\tab Shows the day or month after.\par
{\b Date}\tab Shows the date you type.\par
\page
#{\footnote # options_menu}${\footnote $ Options Menu Commands}K{\footnote K Options menu;Day Settings}+{\footnote + commands:050}
\pard\sb120\sa120\li120{\b\fs28 Options Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Day Settings}\tab Sets the day view's time interval and starting time.\par
\page
