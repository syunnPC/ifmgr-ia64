#{\footnote # appointments}${\footnote $ Entering Appointments}K{\footnote K Entering Appointments}+{\footnote + procedures:010}
\pard\sb120\sa120\li120{\b\fs28 Entering Appointments}\par
\pard\li120\sa60\sb60{\b To enter an appointment}\par
\pard\li360\fi-240\sa60 1.\tab In the day view, move to the time with the direction keys or click it.\par
2.\tab Type the appointment.\par
3.\tab Save the calendar file with Save from the File menu.\par
\pard\li120\sa120 The scratch pad below the appointments holds a note for the day.\par
\page
#{\footnote # moving_about}${\footnote $ Moving Through the Calendar}K{\footnote K Moving Through the Calendar}+{\footnote + procedures:020}
\pard\sb120\sa120\li120{\b\fs28 Moving Through the Calendar}\par
\pard\li120\sa120 CTRL+PGUP and CTRL+PGDN show the previous and next day (or month). Date on the Show menu goes to any date; Today comes back to today. In the month view, double-click a day to see its appointments.\par
\page
#{\footnote # keyboard}${\footnote $ Calendar Keys}K{\footnote K keyboard;keys}
\pard\sb120\sa120\li120{\b\fs28 Calendar Keys}\par
\pard\li120\tx2520\sa60 F8\tab Day view\par
F9\tab Month view\par
F4\tab Show a date\par
CTRL+PGUP\tab Previous day or month\par
CTRL+PGDN\tab Next day or month\par
CTRL+X\tab Cut\par
CTRL+C\tab Copy\par
CTRL+V\tab Paste\par
F1\tab Help Index\par
\page
