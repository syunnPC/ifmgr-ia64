#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;New;Open;Save;Save As;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\tx2160\sa60 {\b New}\tab Starts a new, untitled settings file.\par
{\b Open}\tab Opens a settings file saved earlier.\par
{\b Save}\tab Saves the settings file under its name.\par
{\b Save As}\tab Saves the settings file under a new name.\par
{\b Exit}\tab Ends the program, asking first whether to save changes.\par
\page
#{\footnote # edit_menu}${\footnote $ Edit Menu Commands}K{\footnote K Edit menu;Paste;Clear Buffer}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Edit Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Paste}\tab Sends the Clipboard's text.\par
{\b Clear Buffer}\tab Clears the received text.\par
\page
#{\footnote # settings_menu}${\footnote $ Settings Menu Commands}K{\footnote K Settings menu;Phone Number;Terminal Emulation;Terminal Preferences;Communications;Modem Commands}+{\footnote + commands:030}
\pard\sb120\sa120\li120{\b\fs28 Settings Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Phone Number}\tab The number Dial calls.\par
{\b Terminal Emulation}\tab TTY or DEC VT-100.\par
{\b Terminal Preferences}\tab Local echo, line wrap, CR to CR/LF and the screen.\par
{\b Communications}\tab The port, speed, data bits, parity, stop bits and flow control.\par
{\b Modem Commands}\tab The modem's dial and hangup commands.\par
\page
#{\footnote # phone_menu}${\footnote $ Phone Menu Commands}K{\footnote K Phone menu;Dial;Hangup}+{\footnote + commands:040}
\pard\sb120\sa120\li120{\b\fs28 Phone Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Dial}\tab Dials the phone number through the modem.\par
{\b Hangup}\tab Hangs up.\par
\page
#{\footnote # transfers_menu}${\footnote $ Transfers Menu Commands}K{\footnote K Transfers menu;Send Text File;Receive Text File;Stop}+{\footnote + commands:050}
\pard\sb120\sa120\li120{\b\fs28 Transfers Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Send Text File}\tab Sends a text file.\par
{\b Receive Text File}\tab Saves what comes in to a text file.\par
{\b Stop}\tab Stops a transfer.\par
\page
