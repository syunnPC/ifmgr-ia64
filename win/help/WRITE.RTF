#{\footnote # file_menu}${\footnote $ File Menu Commands}K{\footnote K File menu;New;Open;Save;Save As;Print;Print Setup;Repaginate;Exit}+{\footnote + commands:010}
\pard\sb120\sa120\li120{\b\fs28 File Menu Commands}\par
\pard\li120\tx2160\sa60 {\b New}\tab Starts a new, untitled document.\par
{\b Open}\tab Opens a document saved earlier.\par
{\b Save}\tab Saves the document under its name.\par
{\b Save As}\tab Saves the document under a new name.\par
{\b Print}\tab Prints the document.\par
{\b Print Setup}\tab Chooses the printer.\par
{\b Repaginate}\tab Breaks the document into pages.\par
{\b Exit}\tab Ends the program, asking first whether to save changes.\par
\page
#{\footnote # edit_menu}${\footnote $ Edit Menu Commands}K{\footnote K Edit menu;Undo;Cut;Copy;Paste;Move Picture;Size Picture}+{\footnote + commands:020}
\pard\sb120\sa120\li120{\b\fs28 Edit Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Undo}\tab Undoes the last change.\par
{\b Cut}\tab Moves the selection to the Clipboard.\par
{\b Copy}\tab Copies the selection.\par
{\b Paste}\tab Puts in the Clipboard's contents.\par
{\b Move Picture}\tab Moves the selected picture across the page.\par
{\b Size Picture}\tab Changes the selected picture's size.\par
\page
#{\footnote # find_menu}${\footnote $ Find Menu Commands}K{\footnote K Find menu;Find;Repeat Last Find;Change;Go To Page}+{\footnote + commands:030}
\pard\sb120\sa120\li120{\b\fs28 Find Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Find}\tab Finds text.\par
{\b Repeat Last Find}\tab Finds it again.\par
{\b Change}\tab Changes found text to other text.\par
{\b Go To Page}\tab Goes to a page.\par
\page
#{\footnote # character_menu}${\footnote $ Character Menu Commands}K{\footnote K Character menu;Regular;Bold;Italic;Underline;Superscript;Subscript;Reduce Font;Enlarge Font;Fonts}+{\footnote + commands:040}
\pard\sb120\sa120\li120{\b\fs28 Character Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Regular}\tab Plain characters.\par
{\b Bold}\tab Bold characters.\par
{\b Italic}\tab Italic characters.\par
{\b Underline}\tab Underlined characters.\par
{\b Superscript}\tab Raised characters.\par
{\b Subscript}\tab Lowered characters.\par
{\b Reduce Font}\tab A smaller size.\par
{\b Enlarge Font}\tab A larger size.\par
{\b Fonts}\tab Chooses the font and size.\par
\page
#{\footnote # paragraph_menu}${\footnote $ Paragraph Menu Commands}K{\footnote K Paragraph menu;Normal;Left;Centered;Right;Justified;Single Space;1 1/2 Space;Double Space;Indents}+{\footnote + commands:050}
\pard\sb120\sa120\li120{\b\fs28 Paragraph Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Normal}\tab Single spaced, aligned left, no indents.\par
{\b Left}\tab Aligned left.\par
{\b Centered}\tab Centred.\par
{\b Right}\tab Aligned right.\par
{\b Justified}\tab Aligned at both sides.\par
{\b Single Space}\tab Single line spacing.\par
{\b 1 1/2 Space}\tab One and a half.\par
{\b Double Space}\tab Double.\par
{\b Indents}\tab Left, first-line and right indents.\par
\page
#{\footnote # document_menu}${\footnote $ Document Menu Commands}K{\footnote K Document menu;Header;Footer;Tabs;Page Layout}+{\footnote + commands:060}
\pard\sb120\sa120\li120{\b\fs28 Document Menu Commands}\par
\pard\li120\tx2160\sa60 {\b Header}\tab Text at the top of each page.\par
{\b Footer}\tab Text at the bottom of each page.\par
{\b Tabs}\tab The document's tab stops.\par
{\b Page Layout}\tab The page numbering start and the margins.\par
\page
