#include "windefs.h"
#include "helpmenu.h"
#include "pifedit.h"

PIFEDIT ICON "build\\win\\icons\\pifedit.ico"

PIFEDIT MENU {
    POPUP "&File" {
        MENUITEM "&New", IDM_NEW
        MENUITEM "&Open...", IDM_OPEN
        MENUITEM "&Save", IDM_SAVE
        MENUITEM "Save &As...", IDM_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    }
    POPUP "&Mode" {
        MENUITEM "&Standard", IDM_STANDARD
        MENUITEM "&386 Enhanced", IDM_ENHANCED
    }
    POPUP "&Help" {
        MENUITEM "&Index", IDM_HELPINDEX
        MENUITEM "&Keyboard", IDM_HELPKEYBOARD
        MENUITEM "&Commands", IDM_HELPCOMMANDS
        MENUITEM "&Procedures", IDM_HELPPROCEDURES
        MENUITEM "&Using Help", IDM_HELPUSING
        MENUITEM SEPARATOR
        MENUITEM "&About PIF Editor...", IDM_ABOUT
    }
}

STANDARD DIALOG 20, 20, 262, 194
STYLE WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "PIF Editor"
MENU PIFEDIT
{
    LTEXT "&Program Filename:", -1, 6, 8, 82, 9
    EDITTEXT IDC_PROGRAM, 92, 6, 164, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT "Window &Title:", -1, 6, 24, 82, 9
    EDITTEXT IDC_TITLE, 92, 22, 164, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
