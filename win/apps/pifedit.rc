ABOUT DIALOG 40, 40, 180, 64
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "About PIF Editor"
{
    ICON "PIFEDIT", -1, 8, 8, 18, 20
    LTEXT "PIF Editor", -1, 36, 8, 136, 9
    LTEXT "Program information files tell how to run DOS programs.", -1, 36, 20, 136, 26
    DEFPUSHBUTTON "OK", IDOK, 122, 46, 50, 14, WS_TABSTOP
}

PIFEDIT ACCELERATORS {
    VK_F1, IDM_HELPINDEX, VIRTKEY
}
