    LTEXT "KB &Limit", -1, 182, 105, 36, 9
    EDITTEXT IDC_XMSLIM, 220, 103, 36, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT "Directly Modifies:", -1, 6, 121, 84, 9
    AUTOCHECKBOX "COM&1", IDC_COM1, 92, 120, 40, 10, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX "COM&2", IDC_COM2, 136, 120, 40, 10, WS_TABSTOP
    AUTOCHECKBOX "&Keyboard", IDC_KEYBOARD, 180, 120, 52, 10, WS_TABSTOP
    AUTOCHECKBOX "No Screen &Exchange", IDC_NOSCREEN, 6, 135, 104, 10, WS_TABSTOP | WS_GROUP
