#include "windefs.h"
#include "helpmenu.h"
#include "calc.h"

CALC ICON "build\\win\\icons\\calc.ico"

CALC MENU {
    POPUP "&Edit" {
        MENUITEM "&Copy\tCtrl+C", IDM_COPY
        MENUITEM "&Paste\tCtrl+V", IDM_PASTE
    }
    POPUP "&Help" {
        MENUITEM "&Index", IDM_HELPINDEX
        MENUITEM "&Keyboard", IDM_HELPKEYBOARD
        MENUITEM "&Commands", IDM_HELPCOMMANDS
        MENUITEM "&Procedures", IDM_HELPPROCEDURES
        MENUITEM "&Using Help", IDM_HELPUSING
        MENUITEM SEPARATOR
        MENUITEM "&About Calculator...", IDM_ABOUT
    }
}

CALC ACCELERATORS {
    "^C", IDM_COPY
    "^V", IDM_PASTE
    VK_INSERT, IDM_COPY, VIRTKEY, CONTROL
    VK_INSERT, IDM_PASTE, VIRTKEY, SHIFT
    VK_F1, IDM_HELPINDEX, VIRTKEY
}
